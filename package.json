{
  "name": "webtorrent-cli-client",
  "version": "2.1.0",
  "description": "Node.js terminal client for WebTorrent magnet downloads and multipart HTTP(S) direct downloads with progress bar, peers, and resume.",
  "main": "server.js",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "cross-env NODE_NO_WARNINGS=1 node server.js"
  },
  "keywords": [
    "webtorrent",
    "torrent",
    "magnet-link",
    "magnet-uri",
    "bittorrent",
    "p2p",
    "cli",
    "terminal",
    "nodejs",
    "download",
    "multipart",
    "resume-download",
    "progress-bar"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danted4/webtorrent-cli-client.git"
  },
  "bugs": {
    "url": "https://github.com/danted4/webtorrent-cli-client/issues"
  },
  "homepage": "https://github.com/danted4/webtorrent-cli-client#readme",
  "author": "kanav",
  "license": "MIT",
  "dependencies": {
    "cli-progress": "^3.12.0",
    "webtorrent": "^2.1.27"
  },
  "devDependencies": {
    "cross-env": "^7.0.3"
  }
}
