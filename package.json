{
  "name": "torrent-http-download-cli",
  "version": "2.2.0",
  "description": "Node.js CLI with two download modes: WebTorrent magnet/torrent downloads and parallel multipart HTTP(S) direct downloads with byte-range resume.",
  "main": "server.js",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "cross-env NODE_NO_WARNINGS=1 node server.js"
  },
  "keywords": [
    "torrent",
    "webtorrent",
    "magnet-link",
    "bittorrent",
    "p2p",
    "http-download",
    "direct-download",
    "multipart-download",
    "parallel-download",
    "byte-range",
    "resume-download",
    "cli",
    "terminal",
    "nodejs",
    "progress-bar"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danted4/torrent-http-download-cli.git"
  },
  "bugs": {
    "url": "https://github.com/danted4/torrent-http-download-cli/issues"
  },
  "homepage": "https://github.com/danted4/torrent-http-download-cli#readme",
  "author": "kanav",
  "license": "MIT",
  "dependencies": {
    "cli-progress": "^3.12.0",
    "webtorrent": "^2.1.27"
  },
  "devDependencies": {
    "cross-env": "^7.0.3"
  }
}
